def cross_logprice_elasticity_matrix(df):
    results = []
    
    # Convert to pandas once for all regressions
    df_pd = df.to_pandas()
    
    for brand in brands:
        # Build formula: q_resid_brand ~ p_resid_brand1 + p_resid_brand2 + ...
        dependent_var = f'q_resid_{brand}'
        independent_vars = ' + '.join([f'p_resid_{b}' for b in brands])
        formula = f'{dependent_var} ~ {independent_vars}'
        
        # Fit elasticity model
        model = smf.ols(formula, data=df_pd).fit()
        
        # Extract coefficients for p_resid terms (excluding intercept)
        coef_dict = {'q': brand}
        for param_name, param_value in model.params.items():
            if 'p_resid' in param_name:
                coef_dict[param_name] = param_value
        
        results.append(pl.DataFrame([coef_dict]))
    
    # Combine all results
    elasticity_matrix = pl.concat(results)
    
    return elasticity_matrix

