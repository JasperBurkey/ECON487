    #y_p_second = second_half['log_price'].to_numpy()
    
    # Create feature and outcome sets for first half
    X_first = first_half.drop(drop_cols).to_numpy()
    y_q_first = first_half['logmove'].to_numpy()
    y_p_first = first_half['log_price'].to_numpy()
    
    # Create feature and outcome sets for second half
    X_second = second_half.drop(drop_cols).to_numpy()
    y_q_second = second_half['logmove'].to_numpy()
    y_p_second = second_half['log_price'].to_numpy()
    
    # Apply polynomial features
    poly = PolynomialFeatures(degree=2, include_bias=False)
    X_first_poly = poly.fit_transform(X_first)
    X_second_poly = poly.fit_transform(X_second)  # Use transform, not fit_transform
    
    
    # --- First half models with CV ---
    lgbm_q_first = GridSearchCV(
        HistGradientBoostingRegressor(random_state=487),
        param_grid,
        cv=5,
        n_jobs=-1
    )
    lgbm_q_first.fit(X_first_poly, y_q_first)
    
    lgbm_p_first = GridSearchCV(
        HistGradientBoostingRegressor(random_state=487),
        param_grid,
        cv=5,
        n_jobs=-1
    )
    lgbm_p_first.fit(X_first_poly, y_p_first)
    
    # --- Second half models with CV ---
    lgbm_q_second = GridSearchCV(
        HistGradientBoostingRegressor(random_state=487),
        param_grid,
        cv=5,
        n_jobs=-1
    )
    lgbm_q_second.fit(X_second_poly, y_q_second)
    
    lgbm_p_second = GridSearchCV(
