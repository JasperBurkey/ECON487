    # Filter data for this leaf
    leaf_data = oj_model.filter(pl.col('leaf') == leaf_val)
    
    # Split into two halves
    first_half = leaf_data.sample(fraction=0.5, seed=487)
    second_half = leaf_data.join(
        first_half.select('id'),
        on='id',
        how='anti'
    )
    
    # Define columns to drop
    drop_cols = ['logmove', 'log_price', 'price', 'feat', 'id', 'store', 'leaf', 'q', 'weighted_price', 'week']

    #X_first = first_half.drop(drop_cols).to_pandas()
    #y_q_first = first_half['logmove'].to_numpy()
